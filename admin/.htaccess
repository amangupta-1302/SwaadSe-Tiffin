# ============================================================================
#  SwaadSe Tiffin — password protection for /admin/
# ============================================================================
#
#  WHAT THIS DOES
#  Apache checks the username and password BEFORE it sends anything in this
#  folder. Someone without the password gets a 401 and never receives the page,
#  the HTML, or the JavaScript. That is real protection.
#
#  WHY NOT A LOGIN FORM
#  A login written in JavaScript would need the password inside the page, where
#  anyone can read it with Ctrl+U. It stops nobody. This file is the correct
#  place for the check because the server runs it, not the visitor's browser.
#
#  WHERE THIS WORKS
#  Apache-based hosting only — cPanel, Hostinger, most shared hosting.
#  On Netlify, Cloudflare Pages, Vercel or GitHub Pages this file is IGNORED
#  and /admin/ would be public. Use that host's own access control instead;
#  see the Admin area section of README.md.
#
#  SETUP: see README.md → "Admin area". You must edit AuthUserFile below.
# ============================================================================

# ── 1. HTTPS is mandatory here ───────────────────────────────────────────────
# Basic Auth sends the password base64-encoded, which is NOT encryption. Over
# plain http it is readable by anyone on the same network. Force https first.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ── 2. Require a password ────────────────────────────────────────────────────
AuthType Basic
AuthName "SwaadSe Tiffin admin"

# ✏️ EDIT THIS LINE — it must be the absolute path on the server, not a web URL.
#    cPanel/Hostinger paths usually look like /home/<your-account>/...
#    Keep the file ABOVE public_html so it can never be downloaded.
#    If you used cPanel's "Directory Privacy" tool, cPanel writes this line for
#    you and you can leave it alone.
AuthUserFile "/home/REPLACE-WITH-YOUR-ACCOUNT/.htpasswds/admin/.htpasswd"

Require valid-user

# ── 3. Keep the admin out of search results ──────────────────────────────────
# A 401 already blocks crawlers, but this covers the case where protection is
# accidentally switched off.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

# ── 4. No directory listing ──────────────────────────────────────────────────
Options -Indexes

# ── 5. Never serve the password file, even if it ends up in here by mistake ──
<FilesMatch "^\.(htpasswd|htaccess)$">
  Require all denied
</FilesMatch>
